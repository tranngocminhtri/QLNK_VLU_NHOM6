// Khai báo cho Prisma biết hệ thống dùng cơ sở dữ liệu PostgreSQL
datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.mbypfxgetzflyexeipkf:tranngocminhtri@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
}

// Cấu hình bộ sinh mã để gọi lệnh trong Node.js
generator client {
  provider = "prisma-client-js"
}

// 1. BẢNG DANH MỤC (Lưu thông tin Khoa, Chuyên ngành)
model Category {
  // Khóa chính
  category_id String @id @default(uuid())
  // Tên danh mục (VD: Công nghệ phần mềm)
  name        String
  // Loại danh mục: FIELD (Lĩnh vực) hoặc MAJOR (Chuyên ngành)
  type        String

  // Mối quan hệ: 1 danh mục có nhiều người dùng
  users User[]
}

// 2. BẢNG NGƯỜI DÙNG (Sinh viên, Giảng viên, Admin)
model User {
  // Khóa chính
  user_id       String  @id @default(uuid())
  // Email trường cấp, không được trùng lặp
  email         String  @unique
  // Mật khẩu đã được mã hóa
  password_hash String
  // Họ và tên người dùng
  full_name     String
  // Mã số sinh viên (MSSV) hoặc Mã giảng viên (MGV)
  user_code     String  @unique
  // Số điện thoại (có thể bỏ trống)
  phone         String?
  // Phân quyền: STUDENT, LECTURER, ADMIN, COUNCIL
  role          String

  // Khóa ngoại trỏ về bảng Category (Khoa/Chuyên ngành)
  department_id String?
  department    Category? @relation(fields: [department_id], references: [category_id])

  // CÁC MỐI QUAN HỆ NGƯỢC (Giúp Node.js dễ dàng truy xuất dữ liệu)
  topics_guided Topic[]         @relation("LecturerTopics")
  topic_members TopicMember[]
  comments      Comment[]
  council_roles CouncilMember[]
  scores_given  Score[]
  notifications Notification[]
}

// 3. BẢNG HỘI ĐỒNG (Quản lý các đợt chấm thi)
model Council {
  // Khóa chính
  council_id String   @id @default(uuid())
  // Tên hội đồng
  name       String
  // Ngày tạo hội đồng, tự động lấy giờ hiện tại
  created_at DateTime @default(now())

  // Mối quan hệ ngược
  topics          Topic[]
  council_members CouncilMember[]
}

// 4. BẢNG ĐỀ TÀI (Thông tin cốt lõi của nghiên cứu)
model Topic {
  // Khóa chính
  topic_id         String  @id @default(uuid())
  // Tên đề tài
  title            String
  // Tóm tắt nội dung
  summary          String?
  // Yêu cầu đối với sinh viên ứng tuyển
  requirements     String?
  // Số lượng sinh viên tối đa trong nhóm
  max_members      Int     @default(5)
  // Trạng thái: PENDING_ADMIN, IN_PROGRESS, COMPLETED...
  status           String
  // Tỷ lệ phần trăm đạo văn (từ thuật toán check)
  similarity_score Float?

  // Khóa ngoại trỏ về Giảng viên hướng dẫn
  lecturer_id String?
  lecturer    User?   @relation("LecturerTopics", fields: [lecturer_id], references: [user_id])

  // Khóa ngoại trỏ về Hội đồng chấm thi
  council_id String?
  council    Council? @relation(fields: [council_id], references: [council_id])

  // Mối quan hệ ngược
  members   TopicMember[]
  documents Document[]
  tasks     Task[]
  comments  Comment[]
  scores    Score[]
}

// 5. BẢNG NHÓM SINH VIÊN (Quản lý đơn ứng tuyển và thành viên)
model TopicMember {
  // Khóa chính
  id String @id @default(uuid())

  // Khóa ngoại trỏ về Đề tài
  topic_id String
  topic    Topic  @relation(fields: [topic_id], references: [topic_id])

  // Khóa ngoại trỏ về Sinh viên tham gia
  student_id String
  student    User   @relation(fields: [student_id], references: [user_id])

  // Lời tự giới thiệu khi sinh viên nộp đơn
  cover_letter String?
  // Trạng thái duyệt nhóm: PENDING, APPROVED, REJECTED
  status       String
}

// 6. BẢNG TÀI LIỆU (Lưu link file tải lên Firebase)
model Document {
  // Khóa chính
  document_id String @id @default(uuid())

  // Khóa ngoại trỏ về Đề tài
  topic_id String
  topic    Topic  @relation(fields: [topic_id], references: [topic_id])

  // Tên file hiển thị trên web
  file_name     String
  // Link an toàn trỏ đến Firebase Storage
  file_url      String
  // Mô tả ngắn gọn về file
  description   String?
  // Trạng thái nộp bài: ON_TIME hoặc LATE
  submit_status String?
  // Thời điểm nộp file
  created_at    DateTime @default(now())
}

// 7. BẢNG THẺ TIẾN ĐỘ (Dành cho tính năng Kanban kéo thả)
model Task {
  // Khóa chính
  task_id String @id @default(uuid())

  // Khóa ngoại trỏ về Đề tài
  topic_id String
  topic    Topic  @relation(fields: [topic_id], references: [topic_id])

  // Tên công việc hoặc báo cáo tuần
  title  String
  // Trạng thái thẻ trên Kanban (Chờ đánh giá, Hoàn thành)
  status String
}

// 8. BẢNG BÌNH LUẬN (Nhận xét của giảng viên)
model Comment {
  // Khóa chính
  comment_id String @id @default(uuid())

  // Khóa ngoại trỏ về Đề tài
  topic_id String
  topic    Topic  @relation(fields: [topic_id], references: [topic_id])

  // Khóa ngoại trỏ về người viết bình luận
  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  // Nội dung góp ý
  content String
}

// 9. BẢNG THÀNH VIÊN HỘI ĐỒNG (Ai làm chủ tịch, thư ký...)
model CouncilMember {
  // Khóa chính
  id String @id @default(uuid())

  // Khóa ngoại trỏ về Hội đồng
  council_id String
  council    Council @relation(fields: [council_id], references: [council_id])

  // Khóa ngoại trỏ về Giảng viên tham gia
  lecturer_id String
  lecturer    User   @relation(fields: [lecturer_id], references: [user_id])

  // Vai trò: CHUTICH, THUKY, UYVIEN
  role_in_council String
}

// 10. BẢNG ĐIỂM SỐ
model Score {
  // Khóa chính
  score_id String @id @default(uuid())

  // Khóa ngoại trỏ về Đề tài
  topic_id String
  topic    Topic  @relation(fields: [topic_id], references: [topic_id])

  // Khóa ngoại trỏ về Giảng viên/Thành viên chấm
  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  // Điểm số theo thang 10
  score_value Float
  // Nhận xét phản biện đi kèm
  comment     String?
  // Loại điểm: PROCESS (Điểm quá trình) hoặc FINAL (Điểm bảo vệ)
  score_type  String
}

// 11. BẢNG CẤU HÌNH THỜI GIAN (Timeline đợt đăng ký)
model Timeline {
  // Khóa chính
  timeline_id String   @id @default(uuid())
  // Tên sự kiện mốc thời gian
  event_name  String
  // Thời gian mở cổng
  start_date  DateTime
  // Hạn chót (Deadline) đóng cổng
  end_date    DateTime
}

// 12. BẢNG THÔNG BÁO (Hiển thị chuông trên website)
model Notification {
  // Khóa chính
  notification_id String @id @default(uuid())

  // Khóa ngoại trỏ về người nhận thông báo
  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  // Nội dung thông báo
  content String
  // Đánh dấu đã đọc hay chưa
  is_read Boolean @default(false)
}
