# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.

# Chuỗi kết nối PostgreSQL trên Supabase (Project Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres.<project>:<mat-khau>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Khóa ký JWT - chuỗi ngẫu nhiên dài, tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Google SSO (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, loại Web application)
GOOGLE_CLIENT_ID=

# Supabase Storage - nơi lưu file báo cáo (tạo bucket riêng tư tên "reports")
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=reports

# Gửi email thông báo qua SMTP (UC23). Để trống SMTP_HOST thì chỉ lưu thông báo trong web
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Địa chỉ giao diện được phép gọi API (VD: https://qlnk-vlu.vercel.app). Để trống = cho phép mọi nguồn
FRONTEND_URL=

# Chỉ bật "true" trên máy chạy thử: cho phép Admin bấm nút khôi phục dữ liệu mẫu (XÓA TOÀN BỘ DỮ LIỆU)
ALLOW_SAMPLE_RESET=false
PORT=5000
